{
  "name": "econ-video",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "studio": "remotion studio --browser-executable=/opt/pw-browsers/chromium",
    "tts": "NODE_USE_ENV_PROXY=1 node --no-warnings --experimental-strip-types tools/tts.mjs",
    "layout": "node --no-warnings --experimental-strip-types tools/layout.mjs",
    "sfx": "bash tools/make_sfx.sh",
    "preview": "remotion render Main out/preview.mp4 --scale=0.5 --browser-executable=/opt/pw-browsers/chromium",
    "render": "remotion render Main out/video.mp4 --browser-executable=/opt/pw-browsers/chromium",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@fontsource/nanum-pen-script": "^5.1.0",
    "@fontsource/noto-serif-kr": "^5.1.1",
    "@remotion/cli": "^4.0.242",
    "@types/react": "^18.3.12",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.242",
    "typescript": "^5.6.3"
  }
}
